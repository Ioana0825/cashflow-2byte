# Copy this file to .env and fill in your own values. Never commit .env!
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/cashflow
# Make a random secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60
# Set to true on a real server that uses HTTPS (the login cookie is then only sent over HTTPS)
COOKIE_SECURE=false
# Frontend addresses allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
